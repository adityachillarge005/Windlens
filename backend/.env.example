# ==============================================================================
# WindLens Backend Environment Configuration Template
# Copy to backend/.env when running backend standalone.
# ==============================================================================

# ------------------------------------------------------------------------------
# LOCAL DEVELOPMENT (DEBUG=True)
# ------------------------------------------------------------------------------
DEBUG=True
SECRET_KEY=
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000

# ------------------------------------------------------------------------------
# PRODUCTION DEPLOYMENT (DEBUG=False)
# ------------------------------------------------------------------------------
# In production, SECRET_KEY is strictly required (raises ImproperlyConfigured if unset).
# Generate key: python -c "import secrets; print(secrets.token_urlsafe(50))"
# Wildcard ALLOWED_HOSTS='*' and CORS_ALLOW_ALL_ORIGINS=True are strictly rejected.
#
# DEBUG=False
# SECRET_KEY=generate-and-paste-a-strong-random-key-here
# ALLOWED_HOSTS=your-production-domain.com,api.your-production-domain.com
# CORS_ALLOWED_ORIGINS=https://your-production-frontend.vercel.app

# Elexon BMRS Open API v1 endpoint
ELEXON_BASE_URL=https://data.elexon.co.uk/bmrs/api/v1
