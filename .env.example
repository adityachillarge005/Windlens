# ==============================================================================
# WindLens Environment Configuration Template
# Copy this file to .env and configure for your environment.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. LOCAL DEVELOPMENT CONFIGURATION (Default)
# ------------------------------------------------------------------------------
# In development (DEBUG=True), a safe dev secret key fallback is used if SECRET_KEY
# is omitted, and localhost origins are automatically permitted.
DEBUG=True
SECRET_KEY=
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0,backend
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173

# ------------------------------------------------------------------------------
# 2. PRODUCTION CONFIGURATION (Strict Security)
# ------------------------------------------------------------------------------
# When running in production (DEBUG=False):
# - SECRET_KEY is MANDATORY. Do NOT use example or default keys.
#   Generate a secure key with: python -c "import secrets; print(secrets.token_urlsafe(50))"
# - ALLOWED_HOSTS must list your explicit production hostnames/domains. Wildcard '*' is forbidden.
# - CORS_ALLOW_ALL_ORIGINS=True is forbidden. List exact frontend origin URLs in CORS_ALLOWED_ORIGINS.
#
# DEBUG=False
# SECRET_KEY=generate-and-paste-a-strong-random-key-here
# ALLOWED_HOSTS=yourdomain.com,api.yourdomain.com,backend
# CORS_ALLOWED_ORIGINS=https://yourdomain.com,https://windlens.vercel.app

# ------------------------------------------------------------------------------
# 3. UPSTREAM DATA SOURCE & FRONTEND API CONFIGURATION
# ------------------------------------------------------------------------------
# Official Elexon BMRS Open API v1 endpoint (Source of Truth)
ELEXON_BASE_URL=https://data.elexon.co.uk/bmrs/api/v1

# Frontend API base URL for Vite (relative /api or absolute backend URL)
VITE_API_BASE_URL=http://localhost:8000/api
